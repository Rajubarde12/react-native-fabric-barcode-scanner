{
  "name": "react-native-fabric-barcode-scanner",
  "version": "1.1.0",
  "description": "High-performance native barcode scanner for React Native with TurboModule + Fabric (New Architecture) support on iOS and Android",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "react-native-fabric-barcode-scanner.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepare": "bob build",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "barcode",
    "scanner",
    "qr",
    "qr-code",
    "camera",
    "turbo-module",
    "fabric",
    "new-architecture",
    "mlkit",
    "camerax"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajubarde12/react-native-fabric-barcode-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/Rajubarde12/react-native-fabric-barcode-scanner/issues"
  },
  "homepage": "https://github.com/Rajubarde12/react-native-fabric-barcode-scanner#readme",
  "author": "Rajubarde12 (https://github.com/Rajubarde12)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "~5.9.3"
  },
  "codegenConfig": {
    "name": "RNCustomScannerSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "ScannerView": "ScannerView"
      }
    },
    "android": {
      "javaPackageName": "com.rncustomscanner"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
